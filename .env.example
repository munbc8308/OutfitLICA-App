# OutfitLICA AI API 설정
# 이 파일을 복사하여 .env 파일을 만들고 실제 값을 입력하세요.
# cp .env.example .env

# 옷 카테고리/시즌 자동 분류에 사용 (Claude Vision API)
# 발급: https://console.anthropic.com/
AI_API_KEY=your_anthropic_api_key_here

# 배경 제거 API (https://www.remove.bg/api)
REMOVE_BG_API_KEY=your_remove_bg_api_key

# 날씨 API (https://openweathermap.org/api)
WEATHER_API_KEY=your_openweathermap_api_key
